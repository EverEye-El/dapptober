# thirdweb (required for wallet connect)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (comments/likes actions, Web3 auth routes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paid competition (Base Sepolia first). Leave the contract address blank until it is deployed.
# Both addresses are operators. Either can finalize, add collected fees to the pot, or withdraw those fees.
# OWNER is the thirdweb server wallet. ADMIN is the wallet you connect in the browser.
NEXT_PUBLIC_COMPETITION_ADDRESS=0xfaB606d94256F2a7A5DECE42DdEd404Fe599ce9C
NEXT_PUBLIC_COMPETITION_CHAIN_ID=84532
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_COMPETITION_OWNER=0x97c87d662b7d851eCF57BB894AF7BDa1965F7025
NEXT_PUBLIC_COMPETITION_ADMIN=0x97eac0fb351c405fbcb2bb9d94c14c15c5acaabc
